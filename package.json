{
  "name": "kairo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @kairo/viewer dev",
    "build": "pnpm -r build",
    "build:cloudflare": "pnpm --filter @kairo/viewer build && node scripts/prepare-cloudflare-pages-dist.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@kairo/core": "workspace:*",
    "@kairo/schema": "workspace:*",
    "@kairo/validator": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.17.0"
}
